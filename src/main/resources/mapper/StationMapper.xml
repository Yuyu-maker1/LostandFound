<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jincheng.lostandfound.dao.StationMapper">
  <resultMap id="BaseResultMap" type="com.jincheng.lostandfound.pojo.Station">
    <id column="id" jdbcType="INTEGER" property="id" />
    <result column="station_name" jdbcType="VARCHAR" property="stationName" />
    <result column="city" jdbcType="VARCHAR" property="city" />
    <result column="is_enabled" jdbcType="INTEGER" property="isEnabled" />
    <result column="create_time" jdbcType="TIMESTAMP" property="createTime" />
  </resultMap>

  <sql id="Base_Column_List">
    id, station_name, city, is_enabled, create_time
  </sql>

  <!-- 下拉搜索：仅启用项，支持名称/城市模糊匹配 -->
  <select id="selectEnabled" resultMap="BaseResultMap">
    select <include refid="Base_Column_List" />
    from station
    where is_enabled = 1
    <if test="keyword != null and keyword != ''">
      and (station_name like concat('%', #{keyword,jdbcType=VARCHAR}, '%')
        or city like concat('%', #{keyword,jdbcType=VARCHAR}, '%'))
    </if>
    order by station_name
    limit 20
  </select>

  <select id="selectById" resultMap="BaseResultMap">
    select <include refid="Base_Column_List" />
    from station where id = #{id,jdbcType=INTEGER}
  </select>

  <select id="selectByName" resultMap="BaseResultMap">
    select <include refid="Base_Column_List" />
    from station where station_name = #{stationName,jdbcType=VARCHAR}
  </select>

  <insert id="insert" parameterType="com.jincheng.lostandfound.pojo.Station" useGeneratedKeys="true" keyProperty="id">
    insert into station (station_name, city, is_enabled, create_time)
    values (#{stationName,jdbcType=VARCHAR}, #{city,jdbcType=VARCHAR}, 1, now())
  </insert>
</mapper>
